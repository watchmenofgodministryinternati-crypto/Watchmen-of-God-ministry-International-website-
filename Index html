HTML

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#071b3a">
  <meta name="description" content="Watchmen of God Ministry International - Taking the Gospel to All Nations. A Christ-centered ministry devoted to prayer, the Word of God, and evangelism.">
  <title>Watchmen of God Ministry International</title>

  <style>
    :root {
      --blue: #071b3a;
      --blue-light: #123c72;
      --gold: #e9b949;
      --white: #ffffff;
      --light: #f4f7fc;
      --text: #243047;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--white);
      color: var(--text);
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    header {
      background: var(--blue);
      color: var(--white);
      padding: 15px 6%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
      border-bottom: 3px solid var(--gold);
    }

    .brand {
      font-size: 17px;
      font-weight: bold;
      color: var(--gold);
      max-width: 310px;
    }

    nav {
      display: flex;
      gap: 17px;
      flex-wrap: wrap;
    }

    nav a {
      color: var(--white);
      font-size: 14px;
      font-weight: bold;
    }

    nav a:hover {
      color: var(--gold);
    }

    .hero {
      min-height: 590px;
      padding: 90px 7%;
      display: flex;
      align-items: center;
      text-align: center;
      justify-content: center;
      color: white;
      background:
        linear-gradient(135deg, rgba(4, 19, 43, .96),
        rgba(15, 58, 105, .86)),
        url("https://images.unsplash.com/photo-1507692049790-de58290a4334?auto=format&fit=crop&w=1800&q=85")
        center/cover no-repeat;
    }

    .hero-content {
      max-width: 900px;
    }

    .hero .eyebrow {
      color: var(--gold);
      font-weight: bold;
      letter-spacing: 3px;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(34px, 6vw, 60px);
      line-height: 1.15;
      margin-bottom: 22px;
    }

    .hero h2 {
      color: var(--gold);
      font-size: clamp(19px, 3vw, 28px);
      margin-bottom: 18px;
    }

    .hero p {
      font-size: 18px;
      max-width: 720px;
      margin: 0 auto 30px;
    }

    .buttons {
      display: flex;
      gap: 14px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 12px 23px;
      border-radius: 6px;
      font-weight: bold;
      transition: .2s;
    }

    .btn-gold {
      background: var(--gold);
      color: var(--blue);
    }

    .btn-outline {
      border: 2px solid white;
      color: white;
    }

    .btn:hover {
      transform: translateY(-2px);
      opacity: .9;
    }

    section {
      padding: 75px 7%;
      scroll-margin-top: 20px;
    }

    .section-title {
      text-align: center;
      margin-bottom: 35px;
    }

    .section-title h2 {
      color: var(--blue);
      font-size: clamp(27px, 4vw, 38px);
      margin-bottom: 8px;
    }

    .section-title span {
      display: block;
      width: 70px;
      height: 4px;
      background: var(--gold);
      margin: 12px auto;
    }

    .section-title p {
      max-width: 700px;
      margin: auto;
    }

    .about-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
      align-items: stretch;
    }

    .card {
      background: var(--light);
      border-radius: 10px;
      padding: 27px;
      border-bottom: 4px solid var(--gold);
      box-shadow: 0 5px 18px rgba(0, 0, 0, .05);
    }

    .card h3 {
      color: var(--blue);
      margin-bottom: 12px;
    }

    .icon {
      font-size: 32px;
      margin-bottom: 12px;
    }

    .scripture {
      background: var(--blue);
      color: white;
      text-align: center;
      padding: 65px 7%;
    }

    .scripture h2 {
      color: var(--gold);
      margin-bottom: 15px;
      font-size: 30px;
    }

    .scripture blockquote {
      font-size: 21px;
      max-width: 800px;
      margin: auto;
      font-style: italic;
    }

    .scripture p {
      margin-top: 15px;
      color: var(--gold);
      font-weight: bold;
    }

    .ministries {
      background: var(--light);
    }

    .message-card {
      background: white;
      border-radius: 10px;
      padding: 25px;
      border-left: 5px solid var(--gold);
      margin-bottom: 18px;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .contact-item {
      margin: 15px 0;
      overflow-wrap: anywhere;
    }

    .contact-item strong {
      color: var(--blue);
    }

    .contact-form {
      display: grid;
      gap: 14px;
    }

    .contact-form input,
    .contact-form textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #ccd4e0;
      border-radius: 6px;
      font: inherit;
    }

    .contact-form textarea {
      min-height: 130px;
      resize: vertical;
    }

    .contact-form button {
      border: none;
      cursor: pointer;
      font-size: 16px;
      font-family: inherit;
    }

    .notice {
      font-size: 13px;
      color: #596579;
    }

    .cta {
      background: #edf3fb;
      text-align: center;
    }

    .cta h2 {
      color: var(--blue);
      font-size: 30px;
      margin-bottom: 12px;
    }

    footer {
      background: #041127;
      color: white;
      padding: 35px 7%;
      text-align: center;
    }

    footer strong {
      color: var(--gold);
    }

    footer p {
      margin: 7px 0;
    }

    .back-top {
      display: inline-block;
      margin-top: 12px;
      color: var(--gold);
    }

    @media (max-width: 700px) {
      header {
        justify-content: center;
        text-align: center;
      }

      nav {
        justify-content: center;
        gap: 12px;
      }

      .hero {
        min-height: 500px;
        padding: 65px 6%;
      }

      section {
        padding: 55px 6%;
      }
    }
  </style>
</head>

<body>

  <header id="top">
    <a class="brand" href="#home">
      WATCHMEN OF GOD MINISTRY INTERNATIONAL
    </a>

    <nav aria-label="Main navigation">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#beliefs">Beliefs</a>
      <a href="#ministries">Ministries</a>
      <a href="#messages">Messages</a>
      <a href="#contact">Contact</a>
    </nav>
  </header>

  <main>
    <section class="hero" id="home">
      <div class="hero-content">
        <p class="eyebrow">WELCOME TO OUR MINISTRY</p>

        <h1>Watchmen of God Ministry International</h1>

        <h2>Taking the Gospel to All Nations</h2>

        <p>
          A Christ-centered ministry committed to prayer,
          teaching the Word of God, raising spiritual watchmen,
          and sharing the Gospel in Kampala and beyond.
        </p>

        <div class="buttons">
          <a href="#contact" class="btn btn-gold">
            Visit Our Ministry
          </a>

          <a href="#messages" class="btn btn-outline">
            Explore Messages
          </a>
        </div>
      </div>
    </section>

    <section id="about">
      <div class="section-title">
        <h2>About Our Ministry</h2>
        <span></span>
        <p>
          Standing in the gap through prayer, holiness,
          evangelism, and the truth of God's Word.
        </p>
      </div>

      <div class="about-grid">
        <article class="card">
          <div class="icon">🙏</div>
          <h3>Who We Are</h3>
          <p>
            Watchmen of God Ministry International is a Gospel
            ministry committed to proclaiming Jesus Christ,
            strengthening believers, and reaching communities
            and nations with the Word of God.
          </p>
        </article>

        <article class="card">
          <div class="icon">🎯</div>
          <h3>Our Mission</h3>
          <p>
            To take the Gospel to all nations, raise committed
            disciples of Jesus Christ, encourage a life of prayer,
            and equip believers to serve God faithfully.
          </p>
        </article>

        <article class="card">
          <div class="icon">🌍</div>
          <h3>Our Vision</h3>
          <p>
            To see lives transformed by the power of the Gospel,
            churches strengthened in faith, and spiritual
            watchmen raised to stand in the gap for their
            families, communities, and nations.
          </p>
        </article>
      </div>
    </section>

    <section class="scripture">
      <h2>Our Foundational Scripture</h2>

      <blockquote>
        "Son of man, I have made thee a watchman unto
        the house of Israel: therefore hear the word at
        my mouth, and give them warning from me."
      </blockquote>

      <p>Ezekiel 3:17 (KJV)</p>
    </section>

    <section id="beliefs">
      <div class="section-title">
        <h2>What We Believe</h2>
        <span></span>
        <p>
          Our faith and ministry are founded on the
          teachings of the Holy Bible.
        </p>
      </div>

      <div class="about-grid">
        <article class="card">
          <h3>Jesus Christ</h3>
          <p>
            We believe in Jesus Christ as Lord and Saviour,
            who died for our sins and rose again.
          </p>
          <p><strong>Scripture:</strong> John 3:16</p>
        </article>

        <article class="card">
          <h3>The Holy Bible</h3>
          <p>
            We believe the Word of God guides our faith,
            conduct, teaching, and daily lives.
          </p>
          <p><strong>Scripture:</strong> 2 Timothy 3:16–17</p>
        </article>

        <article class="card">
          <h3>Prayer and Holiness</h3>
          <p>
            We encourage believers to seek God in prayer
            and pursue a life that honours Him.
          </p>
          <p><strong>Scripture:</strong> 1 Thessalonians 5:17</p>
        </article>

        <article class="card">
          <h3>The Great Commission</h3>
          <p>
            We are called to preach the Gospel and make
            disciples of all nations.
          </p>
          <p><strong>Scripture:</strong> Matthew 28:19–20</p>
        </article>
      </div>
    </section>

    <section class="ministries" id="ministries">
      <div class="section-title">
        <h2>Our Ministries</h2>
        <span></span>
        <p>
          Opportunities to grow in faith, serve others,
          and spread the love of Jesus Christ.
        </p>
      </div>

      <div class="about-grid">
        <article class="card">
          <div class="icon">🔥</div>
          <h3>Prayer and Intercession</h3>
          <p>
            Gathering to pray for individuals, families,
            churches, communities, and nations.
          </p>
        </article>

        <article class="card">
          <div class="icon">📖</div>
          <h3>Bible Teaching</h3>
          <p>
            Studying Scripture to grow in understanding,
            spiritual maturity, and obedience to God.
          </p>
        </article>

        <article class="card">
          <div class="icon">📢</div>
          <h3>Evangelism</h3>
          <p>
            Sharing the Gospel through outreach,
            personal witnessing, and community preaching.
          </p>
        </article>

        <article class="card">
          <div class="icon">🤝</div>
          <h3>Fellowship</h3>
          <p>
            Encouraging believers to grow together
            in love, unity, and Christian fellowship.
          </p>
        </article>

        <article class="card">
          <div class="icon">💧</div>
          <h3>Discipleship and Baptism</h3>
          <p>
            Encouraging believers to follow Jesus Christ
            and grow in their walk of faith.
          </p>
        </article>

        <article class="card">
          <div class="icon">🌎</div>
          <h3>Missions</h3>
          <p>
            Reaching people with the Gospel and supporting
            the work of Christ in different communities.
          </p>
        </article>
      </div>
    </section>

    <section id="messages">
      <div class="section-title">
        <h2>Messages and Bible Study</h2>
        <span></span>
        <p>
          Grow spiritually through the Word of God.
          Read these Scriptures and reflect on their message.
        </p>
      </div>

      <article class="message-card">
        <h3>1. The Heart and Its Condition</h3>
        <p>
          <strong>Jeremiah 17:9</strong>
        </p>
        <p>
          Examine your heart before God and seek His wisdom,
          truth, and transformation.
        </p>
      </article>

      <article class="message-card">
        <h3>2. The Call of a Watchman</h3>
        <p><strong>Ezekiel 3:17</strong></p>
        <p>
          Consider the responsibility of hearing God's Word
          and faithfully sharing His message.
        </p>
      </article>

      <article class="message-card">
        <h3>3. A Life of Prayer</h3>
        <p><strong>1 Thessalonians 5:17</strong></p>
        <p>
          Develop a consistent life of prayer and dependence
          on God in every season.
        </p>
      </article>

      <article class="message-card">
        <h3>4. Taking the Gospel to All Nations</h3>
        <p><strong>Matthew 28:19–20</strong></p>
        <p>
          Every believer can play a part in sharing the
          message of Jesus Christ with others.
        </p>
      </article>
    </section>

    <section class="cta">
      <h2>You Are Welcome!</h2>
      <p>
        Join Watchmen of God Ministry International for
        fellowship, prayer, Bible teaching, and evangelism.
      </p>
      <br>
      <a href="#contact" class="btn btn-gold">
        Get in Touch
      </a>
    </section>

    <section id="contact">
      <div class="section-title">
        <h2>Contact Us</h2>
        <span></span>
        <p>
          We welcome you to connect with Watchmen of God
          Ministry International.
        </p>
      </div>

      <div class="contact-grid">
        <div class="card">
          <h3>Our Contact Information</h3>

          <div class="contact-item">
            <strong>Ministry:</strong><br>
            Watchmen of God Ministry International
          </div>

          <div class="contact-item">
            <strong>Location:</strong><br>
            Kampala, Uganda
          </div>

          <div class="contact-item">
            <strong>Email:</strong><br>
            <a href="mailto:holysamuel98@gmail.com">
              holysamuel98@gmail.com
            </a>
          </div>

          <div class="contact-item">
            <strong>Ministry Motto:</strong><br>
            Taking the Gospel to All Nations
          </div>

          <p class="notice">
            Contact us by email for fellowship,
            prayer, ministry, and outreach inquiries.
          </p>
        </div>

        <div class="card">
          <h3>Send Us a Message</h3>

          <form class="contact-form" id="contactForm">
            <input
              type="text"
              id="name"
              placeholder="Your full name"
              autocomplete="name"
              required
            >

            <input
              type="email"
              id="email"
              placeholder="Your email address"
              autocomplete="email"
              required
            >

            <textarea
              id="message"
              placeholder="Write your message or prayer request"
              required
            ></textarea>

            <button class="btn btn-gold" type="submit">
              Send Message by Email
            </button>

            <p class="notice">
              This form opens your email application to send
              the message. It does not send or store messages
              directly on this website.
            </p>
          </form>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p><strong>Watchmen of God Ministry International</strong></p>
    <p>Taking the Gospel to All Nations</p>
    <p>Ezekiel 3:17</p>
    <p>
      &copy; <span id="year"></span>
      Watchmen of God Ministry International.
      All rights reserved.
    </p>
    <a class="back-top" href="#top">Back to Top ↑</a>
  </footer>

  <script>
    document.getElementById("year").textContent =
      new Date().getFullYear();

    document.getElementById("contactForm").addEventListener(
      "submit",
      function (event) {
        event.preventDefault();

        const name = document.getElementById("name").value.trim();
        const email = document.getElementById("email").value.trim();
        const message = document.getElementById("message").value.trim();

        if (!name || !email || !message) {
          alert("Please complete all fields.");
          return;
        }

        const subject = encodeURIComponent(
          "Ministry Website Message from " + name
        );

        const body = encodeURIComponent(
          "Name: " + name +
          "\nEmail: " + email +
          "\n\nMessage:\n" + message
        );

        window.location.href =
          "mailto:holysamuel98@gmail.com?subject=" +
          subject + "&body=" + body;
      }
    );
  </script>

</body>
</html>
